# Keep the build context small and keep host state out of the image.
# .data/ especially: it holds a .orrery.lock naming a pid on the host, and
# baking it in would make the container fight a process that isn't there.
node_modules
.next
.git
.github

.data
.data-*
.herenow
.vercel
.devserver.log

# Secrets never enter the build context. NEXT_PUBLIC_* values that must be
# inlined at build time are passed as --build-arg instead (see Dockerfile).
.env
.env*
**/.env*

*.tsbuildinfo
.impeccable
# tests/ and fixtures/ stay in the context: the production type-check covers
# scripts/hosted-*.ts, which share the loopback gateway adapter with the
# acceptance suite, and the runner image ships fixtures/ so the reference
# apps can be published from a container. Neither reaches the final image
# except fixtures/, copied explicitly in the runner stage.
README.md
PRODUCT.md
docs
Dockerfile
docker-compose.yml
.dockerignore
