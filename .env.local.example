# ---- Supabase auth (optional; without these Orrery runs in local demo mode) ----
# From `supabase start` (local) or Project Settings → API (cloud).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Current name is the publishable key; the legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used by `npm run seed:users` to create test accounts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Secret store (optional; without it Orrery holds no secret values) ----
# Encrypts the per-workspace secret store at <ORRERY_DATA>/secrets.json (AES-256-GCM).
# 32 bytes, base64 or hex. Generate one with:
#   openssl rand -base64 32
# ...which prints something shaped like the line below. Do NOT use this example value.
#   ORRERY_SECRET_KEY=YmFzZTY0IGV4YW1wbGUgb25seSAtIGdlbmVyYXRlIHlvdXJz
# Keep the same key: values written under an old one cannot be read back, and
# there is no recovery — the store is the only copy Orrery has. Without this
# variable every secret write is refused (saying so), and Orrery can still
# record a reference to a value you keep in your own secret manager.
ORRERY_SECRET_KEY=

# ---- Optional ----
# Enables Claude language parsing in the Navigator (deterministic planner otherwise).
ANTHROPIC_API_KEY=
# LocalStack edge endpoint override (default http://localhost:4566).
ORRERY_LOCALSTACK_ENDPOINT=

# Absolute origin used for OpenGraph/share card URLs. Defaults to http://localhost:3400.
NEXT_PUBLIC_SITE_URL=
