{
  "schemaVersion": "2.2",
  "description": "Zenith machine.inspect: OS, kernel, uptime, load, memory and disk facts. Read-only. Output format zenith.machine.inspect/v1.",
  "parameters": {
    "executionTimeout": {
      "type": "String",
      "description": "Seconds before the command is considered failed (1-999).",
      "default": "60",
      "allowedPattern": "^[1-9][0-9]{0,2}$",
      "maxChars": 3
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "zenith",
      "precondition": {
        "StringEquals": [
          "platformType",
          "Linux"
        ]
      },
      "inputs": {
        "timeoutSeconds": "{{ executionTimeout }}",
        "runCommand": [
          "#!/bin/sh",
          "set -u",
          "set -f",
          "LC_ALL=C",
          "export LC_ALL",
          "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
          "export PATH",
          "die() { printf '%s\\n' \"$2\" >&2; exit \"$1\"; }",
          "command -v awk >/dev/null 2>&1 || die 69 'awk is not available on this machine'",
          "osr() { [ -r /etc/os-release ] && sed -n \"s/^$1=//p\" /etc/os-release | head -n 1 | tr -d '\"' | head -c 200; }",
          "echo 'zenith.machine.inspect/v1'",
          "printf 'hostname=%s\\n' \"$(hostname 2>/dev/null | head -c 253)\"",
          "printf 'os_id=%s\\n' \"$(osr ID)\"",
          "printf 'os_version=%s\\n' \"$(osr VERSION_ID)\"",
          "printf 'os_pretty=%s\\n' \"$(osr PRETTY_NAME)\"",
          "printf 'kernel=%s\\n' \"$(uname -r 2>/dev/null | head -c 128)\"",
          "printf 'arch=%s\\n' \"$(uname -m 2>/dev/null | head -c 32)\"",
          "printf 'cpu_count=%s\\n' \"$(getconf _NPROCESSORS_ONLN 2>/dev/null)\"",
          "[ -r /proc/uptime ] && awk '{printf \"uptime_sec=%d\\n\", $1}' /proc/uptime",
          "[ -r /proc/loadavg ] && awk '{printf \"load=%s %s %s\\n\", $1, $2, $3}' /proc/loadavg",
          "[ -r /proc/meminfo ] && awk '/^(MemTotal|MemAvailable|SwapTotal|SwapFree):/ {gsub(\":\", \"\", $1); printf \"mem.%s_kb=%s\\n\", tolower($1), $2}' /proc/meminfo",
          "df -P -k 2>/dev/null | awk 'NR > 1 && $1 ~ /^\\// {printf \"disk=%s\\t%s\\t%s\\t%s\\t%s\\n\", $6, $2, $3, $4, $5}' | head -n 32",
          "exit 0"
        ]
      }
    }
  ]
}
