{
  "schemaVersion": "2.2",
  "description": "Zenith system.metrics: one-second CPU sample plus memory, network, disk and process counts from /proc. Read-only. Output format zenith.system.metrics/v1.",
  "parameters": {
    "executionTimeout": {
      "type": "String",
      "description": "Seconds before the command is considered failed (1-999).",
      "default": "60",
      "allowedPattern": "^[1-9][0-9]{0,2}$",
      "maxChars": 3
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "zenith",
      "precondition": {
        "StringEquals": [
          "platformType",
          "Linux"
        ]
      },
      "inputs": {
        "timeoutSeconds": "{{ executionTimeout }}",
        "runCommand": [
          "#!/bin/sh",
          "set -u",
          "set -f",
          "LC_ALL=C",
          "export LC_ALL",
          "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
          "export PATH",
          "die() { printf '%s\\n' \"$2\" >&2; exit \"$1\"; }",
          "command -v awk >/dev/null 2>&1 || die 69 'awk is not available on this machine'",
          "[ -r /proc/stat ] || die 69 '/proc/stat is not readable on this machine'",
          "cpu() { awk '/^cpu / {idle = $5 + $6; total = 0; for (i = 2; i <= NF; i++) total += $i; print idle, total}' /proc/stat; }",
          "set -- $(cpu)",
          "i1=$1",
          "t1=$2",
          "sleep 1",
          "set -- $(cpu)",
          "i2=$1",
          "t2=$2",
          "echo 'zenith.system.metrics/v1'",
          "dt=$((t2 - t1))",
          "di=$((i2 - i1))",
          "[ \"$dt\" -gt 0 ] && awk -v dt=\"$dt\" -v di=\"$di\" 'BEGIN {printf \"cpu_usage_pct=%.1f\\n\", (dt - di) * 100 / dt}'",
          "printf 'cpu_count=%s\\n' \"$(getconf _NPROCESSORS_ONLN 2>/dev/null)\"",
          "[ -r /proc/uptime ] && awk '{printf \"uptime_sec=%d\\n\", $1}' /proc/uptime",
          "[ -r /proc/loadavg ] && awk '{printf \"load=%s %s %s\\n\", $1, $2, $3}' /proc/loadavg",
          "[ -r /proc/meminfo ] && awk '/^(MemTotal|MemAvailable|SwapTotal|SwapFree):/ {gsub(\":\", \"\", $1); printf \"mem.%s_kb=%s\\n\", tolower($1), $2}' /proc/meminfo",
          "[ -r /proc/net/dev ] && awk -F: 'NR > 2 && $1 !~ /lo$/ {split($2, a, \" \"); rx += a[1]; tx += a[9]} END {printf \"net_rx_bytes=%d\\nnet_tx_bytes=%d\\n\", rx, tx}' /proc/net/dev",
          "[ -r /proc/sys/fs/file-nr ] && awk '{printf \"open_files=%d\\n\", $1}' /proc/sys/fs/file-nr",
          "printf 'process_count=%s\\n' \"$( (set +f; ls -d /proc/[0-9]* 2>/dev/null) | wc -l | tr -d ' ')\"",
          "df -P -k 2>/dev/null | awk 'NR > 1 && $1 ~ /^\\// {printf \"disk=%s\\t%s\\t%s\\t%s\\t%s\\n\", $6, $2, $3, $4, $5}' | head -n 32",
          "exit 0"
        ]
      }
    }
  ]
}
