{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2CreateTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateSubnet",
        "ec2:CreateSecurityGroup",
        "ec2:CreateRouteTable",
        "ec2:CreateNetworkAcl",
        "ec2:CreateInternetGateway",
        "ec2:CreateEgressOnlyInternetGateway",
        "ec2:CreateNatGateway",
        "ec2:CreateVpcEndpoint",
        "ec2:CreateLaunchTemplate",
        "ec2:AllocateAddress"
      ],
      "Resource": "arn:${partition}:ec2:*:${account_id}:*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/zenith:managed": "true"
        },
        "StringLike": {
          "aws:RequestTag/zenith:environment": "${environment_tag_value}"
        }
      }
    },
    {
      "Sid": "Ec2TagOnCreate",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:${partition}:ec2:*:${account_id}:*/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/zenith:managed": "true",
          "ec2:CreateAction": [
            "CreateVpc",
            "CreateSubnet",
            "CreateSecurityGroup",
            "CreateRouteTable",
            "CreateNetworkAcl",
            "CreateInternetGateway",
            "CreateEgressOnlyInternetGateway",
            "CreateNatGateway",
            "CreateVpcEndpoint",
            "CreateLaunchTemplate",
            "CreateVolume",
            "AllocateAddress",
            "RunInstances"
          ]
        }
      }
    },
    {
      "Sid": "Ec2ModifyTaggedResources",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteVpc",
        "ec2:ModifyVpcAttribute",
        "ec2:DeleteSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:ModifySecurityGroupRules",
        "ec2:UpdateSecurityGroupRuleDescriptionsIngress",
        "ec2:UpdateSecurityGroupRuleDescriptionsEgress",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:ReplaceRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:DeleteNetworkAcl",
        "ec2:CreateNetworkAclEntry",
        "ec2:ReplaceNetworkAclEntry",
        "ec2:DeleteNetworkAclEntry",
        "ec2:DeleteInternetGateway",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:DeleteEgressOnlyInternetGateway",
        "ec2:DeleteNatGateway",
        "ec2:DeleteVpcEndpoints",
        "ec2:ModifyVpcEndpoint",
        "ec2:ReleaseAddress",
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress",
        "ec2:DeleteLaunchTemplate",
        "ec2:CreateLaunchTemplateVersion",
        "ec2:ModifyLaunchTemplate",
        "ec2:DeleteLaunchTemplateVersions",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:RebootInstances",
        "ec2:TerminateInstances",
        "ec2:ModifyInstanceAttribute"
      ],
      "Resource": "arn:${partition}:ec2:*:${account_id}:*/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/zenith:managed": "true"
        },
        "StringLike": {
          "aws:ResourceTag/zenith:environment": "${environment_tag_value}"
        }
      }
    },
    {
      "Sid": "EbsCreateTaggedVolumes",
      "Effect": "Allow",
      "Action": "ec2:CreateVolume",
      "Resource": "arn:${partition}:ec2:*:${account_id}:volume/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/zenith:managed": "true",
          "ec2:Encrypted": "true"
        },
        "StringLike": {
          "aws:RequestTag/zenith:environment": "${environment_tag_value}"
        }
      }
    },
    {
      "Sid": "EbsManageTaggedVolumesAndInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVolume",
        "ec2:DeleteVolume",
        "ec2:AttachVolume",
        "ec2:DetachVolume"
      ],
      "Resource": [
        "arn:${partition}:ec2:*:${account_id}:volume/*",
        "arn:${partition}:ec2:*:${account_id}:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/zenith:managed": "true"
        },
        "StringLike": {
          "aws:ResourceTag/zenith:environment": "${environment_tag_value}"
        }
      }
    },
    {
      "Sid": "Ec2RunInstancesNewResources",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:${partition}:ec2:*:${account_id}:instance/*",
        "arn:${partition}:ec2:*:${account_id}:volume/*",
        "arn:${partition}:ec2:*:${account_id}:network-interface/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/zenith:managed": "true"
        },
        "StringLike": {
          "aws:RequestTag/zenith:environment": "${environment_tag_value}"
        }
      }
    },
    {
      "Sid": "Ec2RunInstancesInZenithNetworking",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:${partition}:ec2:*:${account_id}:subnet/*",
        "arn:${partition}:ec2:*:${account_id}:security-group/*",
        "arn:${partition}:ec2:*:${account_id}:launch-template/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/zenith:managed": "true"
        }
      }
    },
    {
      "Sid": "Ec2RunInstancesFromImages",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:${partition}:ec2:*::image/*",
        "arn:${partition}:ec2:*::snapshot/*"
      ]
    },
    {
      "Sid": "DenyChildResourcesInUntaggedVpc",
      "Effect": "Deny",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateSecurityGroup",
        "ec2:CreateRouteTable",
        "ec2:CreateNetworkAcl",
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": "arn:${partition}:ec2:*:${account_id}:vpc/*",
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/zenith:managed": "true"
        }
      }
    },
    {
      "Sid": "DenyNatGatewayInUntaggedSubnetOrAddress",
      "Effect": "Deny",
      "Action": "ec2:CreateNatGateway",
      "Resource": [
        "arn:${partition}:ec2:*:${account_id}:subnet/*",
        "arn:${partition}:ec2:*:${account_id}:elastic-ip/*"
      ],
      "Condition": {
        "StringNotEquals": {
          "aws:ResourceTag/zenith:managed": "true"
        }
      }
    }
  ]
}
