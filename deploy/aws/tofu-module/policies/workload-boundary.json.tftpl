{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WorkloadLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:${partition}:logs:*:${account_id}:log-group:/zenith/*",
        "arn:${partition}:logs:*:${account_id}:log-group:/aws/*/zenith-*"
      ]
    },
    {
      "Sid": "WorkloadImagePull",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage"
      ],
      "Resource": "arn:${partition}:ecr:*:${account_id}:repository/zenith-*"
    },
    {
      "Sid": "WorkloadEcrAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "BuildImagePush",
      "Effect": "Allow",
      "Action": [
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:DescribeImages"
      ],
      "Resource": "arn:${partition}:ecr:*:${account_id}:repository/zenith-*",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:${partition}:iam::${account_id}:role/zenith-*-build"
        }
      }
    },
    {
      "Sid": "BuildSourceVersions",
      "Effect": "Allow",
      "Action": "s3:GetObjectVersion",
      "Resource": "arn:${partition}:s3:::zenith-*/*",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:${partition}:iam::${account_id}:role/zenith-*-build"
        },
        "StringEquals": {
          "s3:ResourceAccount": "${account_id}"
        }
      }
    },
    {
      "Sid": "BuildSiteInvalidation",
      "Effect": "Allow",
      "Action": "cloudfront:CreateInvalidation",
      "Resource": "arn:${partition}:cloudfront::${account_id}:distribution/*",
      "Condition": {
        "ArnLike": {
          "aws:PrincipalArn": "arn:${partition}:iam::${account_id}:role/zenith-*-build"
        },
        "StringEquals": {
          "aws:ResourceTag/zenith:managed": "true"
        }
      }
    },
    {
      "Sid": "WorkloadEksSystemImages",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage"
      ],
      "Resource": [
        "arn:${partition}:ecr:*:*:repository/eks/*",
        "arn:${partition}:ecr:*:*:repository/amazon-k8s-cni"
      ]
    },
    {
      "Sid": "WorkloadEksDescribe",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeInstanceTypes",
        "ec2:DescribeRouteTables",
        "ec2:DescribeSecurityGroups",
        "ec2:DescribeSubnets",
        "ec2:DescribeVolumes",
        "ec2:DescribeVolumesModifications",
        "ec2:DescribeVpcs",
        "ec2:DescribeTags",
        "ec2:DescribeAvailabilityZones"
      ],
      "Resource": "*"
    },
    {
      "Sid": "WorkloadEksClusterReadAndPodIdentity",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster",
        "eks-auth:AssumeRoleForPodIdentity"
      ],
      "Resource": "arn:${partition}:eks:*:${account_id}:cluster/zenith-${environment_tag_value}-*"
    },
    {
      "Sid": "WorkloadEksNetworkInterfaces",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachNetworkInterface",
        "ec2:DetachNetworkInterface",
        "ec2:ModifyNetworkInterfaceAttribute"
      ],
      "Resource": "arn:${partition}:ec2:*:${account_id}:network-interface/*"
    },
    {
      "Sid": "WorkloadEksTaggedNodes",
      "Effect": "Allow",
      "Action": [
        "ec2:AttachNetworkInterface",
        "ec2:DetachNetworkInterface",
        "ec2:ModifyNetworkInterfaceAttribute"
      ],
      "Resource": "arn:${partition}:ec2:*:${account_id}:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/zenith:managed": "true"
        },
        "StringLike": {
          "aws:ResourceTag/zenith:environment": "${environment_tag_value}"
        }
      }
    },
    {
      "Sid": "WorkloadEksCniTags",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": "arn:${partition}:ec2:*:${account_id}:network-interface/*",
      "Condition": {
        "ForAllValues:StringEquals": {
          "aws:TagKeys": [
            "node.k8s.amazonaws.com/instance_id",
            "node.k8s.amazonaws.com/createdAt",
            "cluster.k8s.amazonaws.com/name",
            "eks:eni:owner"
          ]
        }
      }
    },
    {
      "Sid": "WorkloadEksKeyMetadata",
      "Effect": "Allow",
      "Action": "kms:DescribeKey",
      "Resource": "arn:${partition}:kms:*:${account_id}:key/*"
    },
    {
      "Sid": "WorkloadSnsPublish",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:${partition}:sns:*:${account_id}:zenith-${environment_tag_value}-*"
    },
    {
      "Sid": "WorkloadObjectsAndQueues",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "sqs:SendMessage",
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes",
        "sqs:GetQueueUrl"
      ],
      "Resource": [
        "arn:${partition}:s3:::zenith-*",
        "arn:${partition}:s3:::zenith-*/*",
        "arn:${partition}:sqs:*:${account_id}:zenith-*"
      ]
    },
    {
      "Sid": "WorkloadReadItsOwnSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:DescribeSecret",
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:${partition}:secretsmanager:*:${account_id}:secret:zenith/*",
        "arn:${partition}:ssm:*:${account_id}:parameter/zenith/*"
      ]
    },
    {
      "Sid": "WorkloadKmsViaServices",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "kms:CallerAccount": "${account_id}"
        },
        "StringLike": {
          "kms:ViaService": [
            "secretsmanager.*.amazonaws.com",
            "ssm.*.amazonaws.com",
            "s3.*.amazonaws.com",
            "sqs.*.amazonaws.com",
            "sns.*.amazonaws.com",
            "ec2.*.amazonaws.com",
            "eks.*.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "WorkloadVpcNetworkInterfaces",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNetworkInterface",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DeleteNetworkInterface",
        "ec2:AssignPrivateIpAddresses",
        "ec2:UnassignPrivateIpAddresses"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyIdentityOrgAndAccountAdministration",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "organizations:*",
        "account:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyStateBucket",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "${state_bucket_arn}",
        "${state_bucket_arn}/*"
      ]
    }
  ]
}
