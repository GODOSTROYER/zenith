ARG COMPILER_IMAGE
FROM ${COMPILER_IMAGE} AS compile
# Verifier resolves this compiler image to a digest containing cc and static libc; no package download.
COPY deploy/zenith-managed/build/fixture-app.c /src/app.c
RUN cc -static -Os -s -o /app /src/app.c
FROM scratch
COPY --from=compile /app /app
USER 65532:65532
ENTRYPOINT ["/app"]


