{
  "apiVersion": "node.k8s.io/v1",
  "kind": "RuntimeClass",
  "metadata": {
    "name": "zenith-build-gvisor",
    "labels": { "zenith.dev/purpose": "isolated-build" },
    "annotations": {
      "zenith.dev/status": "Owner-approved 2026-10-21 (see docs/build/production/verify/ISOLATED-BUILD-PROFILES-REVIEW.md).",
      "zenith.dev/handler-source": "Reuses the runsc handler installed by deploy/zenith-managed/runtime/setup-kind.ts (J14)."
    }
  },
  "handler": "runsc",
  "overhead": { "podFixed": { "cpu": "50m", "memory": "64Mi" } },
  "scheduling": { "nodeSelector": { "zenith.dev/runtime": "gvisor" } }
}
