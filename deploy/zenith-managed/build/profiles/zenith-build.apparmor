# Owner-approved 2026-10-21 (see docs/build/production/verify/ISOLATED-BUILD-PROFILES-REVIEW.md).
# Review: docs/build/production/verify/ISOLATED-BUILD-PROFILES-REVIEW.md
#
# AppArmor profile "zenith-build" for the J6 rootless BuildKit build Job.
# Install on the build node as /etc/apparmor.d/zenith-build, then:
#   apparmor_parser -r /etc/apparmor.d/zenith-build
# The Job refers to it as appArmorProfile {type: Localhost, localhostProfile: zenith-build}.
#
# Shape follows Docker's docker-default template (moby/profiles apparmor, "template.go").
# It is NOT syntax-checked yet: apparmor_parser is not available where this was written.
# Deliberate deviation from the request "deny writes outside the workspace and /tmp":
# the profile also confines every build step, and a step writes to ITS OWN root
# filesystem, which AppArmor sees as "/". A workspace-only write rule would fail every
# RUN instruction. Write confinement for the outer container comes from the Job spec
# (readOnlyRootFilesystem, writable emptyDirs only at /work, /tmp, /run/user/1000,
# /home/user). See the review document, section "What each profile does".

#include <tunables/global>

profile zenith-build flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  # --- Network: TCP/UDP over IPv4/IPv6, unix sockets, route netlink. No raw or packet sockets.
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  network unix,
  network netlink raw,
  deny network packet,
  deny network inet raw,
  deny network inet6 raw,
  unix,

  # --- Capabilities: only what rootless BuildKit / runc need, and only inside the user
  # namespaces they create. AppArmor checks these in user namespaces as well.
  capability setuid,          # newuidmap / newgidmap
  capability setgid,
  capability setpcap,
  capability setfcap,
  capability sys_admin,       # mount, pivot_root, unshare inside the nested user namespace only
  capability sys_chroot,
  capability chown,
  capability dac_override,
  capability dac_read_search,
  capability fowner,
  capability fsetid,
  capability kill,
  capability mknod,
  capability net_bind_service,
  # Every capability not listed above is denied by default (including bpf, perfmon and
  # checkpoint_restore, which older apparmor_parser versions cannot name). Explicit denies:
  deny capability net_raw,
  deny capability net_admin,
  deny capability sys_module,
  deny capability sys_rawio,
  deny capability sys_boot,
  deny capability sys_time,
  deny capability sys_ptrace,
  deny capability sys_pacct,
  deny capability sys_tty_config,
  deny capability sys_resource,
  deny capability syslog,
  deny capability mac_admin,
  deny capability mac_override,
  deny capability audit_control,
  deny capability audit_write,
  deny capability block_suspend,
  deny capability wake_alarm,
  deny capability linux_immutable,
  deny capability lease,

  # --- Files: broad, because build steps own their root filesystem (see header).
  file,

  # /proc and /sys writes. procMount is Unmasked in the Job, so the kernel's default
  # read-only masking of /proc is off; these rules replace it.
  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9]*}/** w,
  deny @{PROC}/sys/** w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny @{PROC}/kmsg rwklx,
  deny @{PROC}/kallsyms rwklx,
  deny @{PROC}/sched_debug rwklx,
  deny @{PROC}/timer_list rwklx,
  deny /sys/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  deny /sys/kernel/debug/** rwklx,
  deny /sys/kernel/tracing/** rwklx,
  deny /sys/fs/bpf/** rwklx,
  deny /sys/fs/pstore/** rwklx,

  # Raw devices and kernel memory.
  deny /dev/mem rwklx,
  deny /dev/kmem rwklx,
  deny /dev/port rwklx,
  deny /dev/kmsg rwklx,
  deny /dev/sd* rwklx,
  deny /dev/hd* rwklx,
  deny /dev/vd* rwklx,
  deny /dev/xvd* rwklx,
  deny /dev/nvme* rwklx,
  deny /dev/loop* rwklx,
  deny /dev/dm-* rwklx,
  deny /dev/mapper/** rwklx,

  # --- Mounts: allowed (rootlesskit and runc mount inside their own user+mount
  # namespaces; the kernel refuses mounts outside them), except filesystems that expose
  # kernel internals.
  mount,
  remount,
  umount,
  pivot_root,
  deny mount fstype=(securityfs,debugfs,tracefs,bpf,pstore,configfs,efivarfs,selinuxfs,fusectl,binfmt_misc,hugetlbfs,nfs,nfs4,cifs,smb3,9p,ecryptfs),

  # --- Processes and signals.
  # Same-profile processes may read each other's /proc entries (runc needs /proc/<pid>/ns);
  # nobody may trace. Runtime/shim processes outside the profile may signal the container.
  ptrace (read, readby) peer=zenith-build,
  deny ptrace (trace, tracedby),
  signal (send, receive) peer=zenith-build,
  signal (receive) peer=unconfined,
}
