 }
+
+func (a *Agent) waitUpdate(ctx context.Context, delay time.Duration) bool {
+	if a.updateControl == nil {
+		return sleepCtx(ctx, delay)
+	}
+	timer := time.NewTimer(delay)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return false
+	case <-timer.C:
+		return true
+	case <-a.updateControl.Wake():
+		return true
+	}
+}
