# Optional fixed-purpose local helper. The ordinary zenithd.service is unchanged.
# Installation requires reviewed root-pinned data-only profiles; this unit does
# not fetch, update, remove, reconcile or retry packages.
[Unit]
Description=Zenith pinned offline package helper
Documentation=https://github.com/GODOSTROYER/zenith/blob/master/docs/platform/ZENITHD.md
ConditionPathExists=/etc/zenithd/package-install.json
Before=zenithd.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/zenithd package-helper --config /etc/zenithd/package-install.json
# An uncertain/torn state or stale socket requires operator investigation.
Restart=no
TimeoutStopSec=310s
KillMode=control-group
UMask=0077
RuntimeDirectory=zenithd-package-install
RuntimeDirectoryMode=0755
StateDirectory=zenithd-package-install
StateDirectoryMode=0700
ReadWritePaths=/var/lib/zenithd-package-install /var/lib/dpkg /opt/zenith-packages /run/zenithd-package-install
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=default
ProcSubset=all
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
