{
  "name": "zenith",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "description": "Zenith — a bring-your-own-cloud deployment and operations platform. Your infrastructure, in motion.",
  "scripts": {
    "dev": "next dev --turbopack -p 3400",
    "dev:webpack": "next dev -p 3400",
    "build": "next build",
    "start": "next start -p 3400",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm test && npm run smoke && npm run gimbal:verify",
    "gimbal:build": "node scripts/gimbal-build.mjs",
    "gimbal:verify": "node scripts/gimbal-verify.mjs",
    "cost:catalog": "tsx scripts/cost/refresh-catalog.ts",
    "seed": "tsx scripts/seed.ts",
    "smoke": "tsx scripts/smoke.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "seed:users": "tsx scripts/seed-users.ts",
    "migrate:postgres": "tsx --env-file-if-exists=.env.local scripts/migrate-to-postgres.ts",
    "migrate:hosted": "tsx --env-file-if-exists=.env.local scripts/migrate-hosted-to-postgres.ts",
    "migrate:alert-secrets": "tsx --env-file-if-exists=.env.local scripts/migrate-alert-secrets.ts",
    "vault:rewrap": "tsx --env-file-if-exists=.env.local scripts/vault-rewrap.ts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "setup": "tsx --env-file-if-exists=.env.local scripts/setup.ts",
    "doctor": "tsx --env-file-if-exists=.env.local scripts/doctor.ts",
    "localstack:up": "docker compose up -d localstack",
    "localstack:down": "docker compose stop localstack",
    "localstack:logs": "docker compose logs -f localstack",
    "docker:build": "docker compose --profile app build",
    "docker:up": "docker compose --profile app up -d",
    "docker:down": "docker compose --profile app down",
    "hosted:backup": "tsx --env-file-if-exists=.env.local scripts/hosted/backup.ts",
    "hosted:restore": "tsx --env-file-if-exists=.env.local scripts/hosted/restore.ts",
    "hosted:reopen": "tsx --env-file-if-exists=.env.local scripts/hosted/reopen.ts",
    "hosted:scorecard": "tsx --env-file-if-exists=.env.local scripts/hosted/scorecard.ts",
    "hosted:backup-live-check": "tsx --env-file-if-exists=.env.local scripts/hosted/backup-live-check.ts",
    "hosted:acceptance": "tsx scripts/hosted-acceptance.ts",
    "hosted:browser": "tsx scripts/hosted-browser.ts",
    "agent:acceptance": "tsx scripts/agent-acceptance.ts",
    "agent:browser": "tsx scripts/agent-browser.ts",
    "test:contract": "vitest run tests/db/contract --no-file-parallelism",
    "migrate:platform": "tsx --env-file-if-exists=.env.local scripts/platform/migrate.ts",
    "platform:emit-sql": "tsx scripts/platform/emit-sql.ts",
    "policy:build": "node policy/build.mjs",
    "policy:check": "node policy/build.mjs --check",
    "ledger": "node scripts/build/ledger.mjs",
    "worker": "tsx --env-file-if-exists=.env.local workers/execution/worker.ts",
    "cli": "tsx src/cli/bin.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@aws-sdk/client-acm": "3.1121.0",
    "@aws-sdk/client-application-auto-scaling": "3.1121.0",
    "@aws-sdk/client-auto-scaling": "3.1121.0",
    "@aws-sdk/client-cloudfront": "3.1121.0",
    "@aws-sdk/client-cloudwatch": "3.1121.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1121.0",
    "@aws-sdk/client-codebuild": "3.1121.0",
    "@aws-sdk/client-ec2": "3.1121.0",
    "@aws-sdk/client-ecr": "3.1121.0",
    "@aws-sdk/client-ecs": "3.1121.0",
    "@aws-sdk/client-eks": "3.1121.0",
    "@aws-sdk/client-elastic-load-balancing-v2": "3.1121.0",
    "@aws-sdk/client-elasticache": "3.1121.0",
    "@aws-sdk/client-eventbridge": "3.1121.0",
    "@aws-sdk/client-iam": "3.1121.0",
    "@aws-sdk/client-kms": "3.1121.0",
    "@aws-sdk/client-lambda": "3.1121.0",
    "@aws-sdk/client-rds": "3.1121.0",
    "@aws-sdk/client-resource-groups-tagging-api": "3.1121.0",
    "@aws-sdk/client-route-53": "3.1121.0",
    "@aws-sdk/client-s3": "^3.830.0",
    "@aws-sdk/client-secrets-manager": "3.1121.0",
    "@aws-sdk/client-sns": "3.1121.0",
    "@aws-sdk/client-sqs": "^3.830.0",
    "@aws-sdk/client-ssm": "3.1121.0",
    "@aws-sdk/client-sts": "3.1121.0",
    "@dagrejs/dagre": "^1.1.4",
    "@electric-sql/pglite": "0.5.8",
    "@kubernetes/client-node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "opa-wasm-yaml": "npm:yaml@1.10.3",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "@vitejs/plugin-react": "5.1.4",
    "@xyflow/react": "^12.6.4",
    "clsx": "^2.1.1",
    "e2b": "2.46.1",
    "gsap": "^3.15.0",
    "jose": "6.2.12",
    "js-yaml": "^4.1.0",
    "lenis": "^1.3.0",
    "lucide-react": "^0.511.0",
    "meshoptimizer": "^1.2.0",
    "mysql2": "^3.24.5",
    "next": "15.5.24",
    "nodemailer": "10.0.9",
    "postgres": "^3.4.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "^0.185.1",
    "vite": "7.3.6",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@temporalio/testing": "1.24.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.185.4",
    "aws-sdk-client-mock": "4.1.0",
    "eslint": "^9.29.0",
    "eslint-config-next": "15.5.24",
    "jsdom": "^30.0.1",
    "ktx2-encoder": "^0.6.0",
    "playwright-core": "^1.56.1",
    "picomatch": "4.0.7",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "4.1.11"
  },
  "bin": {
    "zenith": "src/cli/bin.ts"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "undici@8": "8.10.2",
    "e2b": {
      "undici8": "npm:undici@8.10.2"
    },
    "next": {
      "postcss": "8.5.23"
    },
    "@next/eslint-plugin-next@15.5.24": {
      "fast-glob": "npm:glob@13.0.6"
    },
    "vitest": {
      "vite": "$vite"
    }
  }
}
