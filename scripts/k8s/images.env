# Pinned inputs for the Kubernetes lifecycle acceptance profile (PROD-LIFE-07).
# Sourced by the scripts in this directory and parsed by
# tests/providers/kubernetes/lifecycle-profile.test.ts, which fails when any image
# reference here is not pinned by sha256 digest or when the kind config drifts.
#
# Every container image is a registry-published index digest read on 2026-10-07:
#   kindest/node            kubernetes-sigs/kind v0.33.0 release notes
#   quay.io/calico/*        Docker-Content-Digest of the v3.32.2 tags on quay.io
#   docker.io/library/busybox  Docker-Content-Digest of the 1.37.0 tag
# The Calico manifest is a file, not an image: it is downloaded from its release tag
# and refused unless its sha256 equals CALICO_MANIFEST_SHA256, and every image it
# names is then rewritten to the digests below before anything is applied.
#
# To move a pin: change the version and digest together, re-read the digest from
# the registry, and rerun the profile. Never replace a digest with a tag.

KIND_MIN_VERSION=0.33.0
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5

CALICO_VERSION=v3.32.2
CALICO_MANIFEST_URL=https://raw.githubusercontent.com/projectcalico/calico/v3.32.2/manifests/calico.yaml
CALICO_MANIFEST_SHA256=a8c828a06a87c629a282ebbc424895b77f3a030251993e41ea400a743675bb02
CALICO_CNI_IMAGE=quay.io/calico/cni:v3.32.2@sha256:0ef740bc587f25565905adf1d1f61a7faff0d571c449c6bdd789feed743d3ef7
CALICO_NODE_IMAGE=quay.io/calico/node:v3.32.2@sha256:99b03fe91e8bfbcb153ae65ef4b701b24ce541ffdd74ff314eb041096008f7fd
CALICO_KUBE_CONTROLLERS_IMAGE=quay.io/calico/kube-controllers:v3.32.2@sha256:7870b67ebb13fabc3005252b44fe6e78b21635649bd3072b80afa1684b6565d0

# The workload image of every acceptance pod: a server (httpd), a client (wget) and a
# shell for jobs in one small image.
ACCEPTANCE_IMAGE=docker.io/library/busybox:1.37.0@sha256:bdf57e528e45e4433820e045b29b4597825a1c9e38353532d90a01445013f82e
