  "changes": [
    "OPA strings requires the licensed local sprintf source; all exception propagation is preserved",
    "OPA yaml requires an honest registry alias of the exact previously locked YAML1.10.3",
    "sprintf parse validates e/f0..100 and g1..100 before native conversion and raises fixed value-free RangeError; no clamping/undefined conversion",
    "The local typed entry forwards the published loader declaration",
    "Exact line-scoped ESLint annotations preserve licensed upstream CommonJS and declaration ABI; removing the annotations reconstructs the pre-annotation bytes"
  ],
  "advisory": "https://github.com/advisories/GHSA-hp3w-g68c-fv3c",
  "scope": "Only invalid numeric precision is repaired; this is not a claim that arbitrary formatter input is generally bounded",
  "verification": "Tests and final runtime review are separate; provenance does not claim npm package publication or maintainer approval"
